# Example Forgejo credential file (shared grammar, owned by the dev-agents spec).
#
# Pass its ABSOLUTE path as the credential_file argument on each tool call. The
# file must be a regular, non-symlink file you own, mode 0600, inside a private
# 0700 directory, with no symlink anywhere in its path:
#
#   install -d -m 0700 ~/.config/vbcdx/forgejo
#   install -m 0600 /dev/null ~/.config/vbcdx/forgejo/code-agent.env
#   # then edit in the real values
#
# Grammar: blank lines and #-comment lines are ignored; the value is everything
# after the first '=' with surrounding whitespace trimmed; it is LITERAL (no
# shell expansion — a $ stays a $). Single quotes are literal; double quotes use
# JSON string escaping. Duplicate keys are rejected.

VBCDX_AGENTS_ROLE=code-agent
VBCDX_AGENTS_USER=example-bot
VBCDX_AGENTS_TOKEN=replace-with-a-forgejo-access-token
# VBCDX_AGENTS_PASSWORD is optional; used only as the single retry after a token 401.
# VBCDX_AGENTS_PASSWORD=replace-with-a-password-if-no-token
