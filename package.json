{
  "name": "@vbcdx/forgejo-plugin",
  "version": "0.1.1",
  "description": "MCP server exposing a finite, verified Forgejo tool catalog. Contract vbcdx.forgejo/1.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vbcdx-forgejo": "bin/vbcdx-forgejo.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./manifest": "./src/manifest.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE",
    "vbcdx.json",
    ".env.example"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "manifest": "node bin/vbcdx-forgejo.js manifest",
    "lint": "node scripts/lint.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "VBCDX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VBCDX/forgejo-plugin.git"
  },
  "homepage": "https://github.com/VBCDX/forgejo-plugin#readme",
  "bugs": {
    "url": "https://github.com/VBCDX/forgejo-plugin/issues"
  }
}
