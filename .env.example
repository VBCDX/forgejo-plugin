# Service configuration for the vbcdx-forgejo MCP server (spec §3).
# These service settings are read once, at startup. There is no CODE_HOST_*,
# FORGEJO_AGENT, ambient token/password or VBCDX_AGENTS_* launch fallback.
# Credentials are NEVER configured here: stdio mode reads an absolute
# credential_file per tool call; network (serve) mode reads the Authorization
# header per request.

# Required for any tool call. Instance origin, optional deployment subpath, and
# an optional trailing /api/v1 (appended exactly once if absent). HTTP(S) only;
# no userinfo, query or fragment.
VBCDX_FORGEJO_URL=https://git.example.com

# off (default) refuses all writes; write allows ordinary writes; full also
# allows destructive tools (delete_comment, merge_pull_request,
# cancel_workflow_run). This is an accident control, not an approval boundary.
VBCDX_FORGEJO_WRITES=off

# Total per-call deadline in milliseconds. Default 30000; range 1000-120000.
VBCDX_FORGEJO_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Network mode only (the `serve` command / Docker container); ignored by stdio.
# In this mode credentials are supplied PER REQUEST in the Authorization header
# (Bearer/token <PAT> or Basic <base64(user:password)>), never in the env.
# ---------------------------------------------------------------------------

# Listen port for `serve` (default 8080).
# VBCDX_FORGEJO_HTTP_PORT=8080

# Bind address for `serve` (default 0.0.0.0).
# VBCDX_FORGEJO_HTTP_HOST=0.0.0.0

# Serve HTTPS directly by pointing these at PEM files (set BOTH or neither).
# Leave unset to serve plain HTTP behind a TLS-terminating proxy or on a trusted
# network. The outbound connection to Forgejo always verifies TLS regardless.
# VBCDX_FORGEJO_TLS_CERT=/absolute/path/to/cert.pem
# VBCDX_FORGEJO_TLS_KEY=/absolute/path/to/key.pem

# DSH bridge only (see cordis.patch.yml): absolute path to this package's
# installed bin/vbcdx-forgejo.js. Not a server CLI argument or a credential.
# VBCDX_FORGEJO_ENTRYPOINT=/absolute/path/to/node_modules/@vbcdx/forgejo-plugin/bin/vbcdx-forgejo.js
